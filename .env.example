# Porta em que o servidor HTTP + WebSocket vai escutar.
# A maioria dos serviços de hospedagem (Render, Railway, Fly.io etc.)
# define isso automaticamente — nesse caso você não precisa mexer aqui.
PORT=3000

# Arquivo do banco SQLite (padrão: data/bingo.sqlite).
# DB_FILE=/caminho/para/plataforma.sqlite

# PIN da área do professor (/professor). Com PIN, só quem o digitar vê a
# turma, cadastra contas e cria salas de bingo. Sem PIN, a área fica aberta.
# PROFESSOR_PIN=1234
